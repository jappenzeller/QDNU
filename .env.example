# PROMPT AWS-003 - environment variables for the Braket validation pipeline.
# Copy to .env and fill in. Do not commit .env. AWS credentials use the
# standard credential chain (env vars, ~/.aws/credentials, SSO); this file
# does not hold secrets.

# Region for every Braket and downstream artifact. Pinned to us-east-1 because
# SV1, S3, Lambda, Athena, and QuickSight all live in the same region and
# region drift breaks the pipeline.
AWS_REGION=us-east-1

# S3 bucket for Braket task outputs. Convention is amazon-braket-{account-id}-
# {region}; the bucket must already exist (created on first Braket use, or
# explicitly via aws s3 mb). Replace {account-id} with the 12-digit account.
BRAKET_OUTPUT_S3_BUCKET=amazon-braket-{account-id}-us-east-1

# Optional S3 key prefix under the bucket for AWS-003 outputs. Defaults to
# "validation/aws-003" if unset.
BRAKET_OUTPUT_S3_PREFIX=validation/aws-003
