{
  "_comment": "PROMPT AWS-004 - explicit Glue table schema for the locked AWS-003 contract. Source of truth; bootstrap_data_layer.py reads this and creates/updates the Glue table. Edit values, never structure, unless coordinated with a schema bump.",
  "database": "aws004",
  "table_name": "braket_results",
  "description": "Processed records emitted by scripts/braket/braket_*_validation.py. One row per (prompt_id, device, subject, timestamp).",
  "serde": "org.openx.data.jsonserde.JsonSerDe",
  "serde_parameters": {
    "case.insensitive": "false",
    "ignore.malformed.json": "false"
  },
  "input_format": "org.apache.hadoop.mapred.TextInputFormat",
  "output_format": "org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat",
  "columns": [
    {"Name": "timestamp", "Type": "string"},
    {"Name": "segment_id", "Type": "string"},
    {"Name": "channels", "Type": "int"},
    {"Name": "window_s", "Type": "double"},
    {"Name": "shots", "Type": "int"},
    {"Name": "encoding", "Type": "string"},
    {"Name": "params", "Type": "array<array<double>>"},
    {"Name": "device_arn", "Type": "string"},
    {"Name": "adapter_applied", "Type": "boolean"},
    {"Name": "aer", "Type": "struct<counts:map<string,int>,z_ancilla:double,z_e:array<double>,z_i:array<double>>"},
    {"Name": "braket", "Type": "struct<counts:map<string,int>,z_ancilla:double,z_e:array<double>,z_i:array<double>>"},
    {"Name": "diff", "Type": "struct<z_ancilla_abs:double,z_e_max_abs:double,z_i_max_abs:double,tvd:double>"},
    {"Name": "pass", "Type": "boolean"},
    {"Name": "task_arn", "Type": "string"},
    {"Name": "s3_bucket", "Type": "string"},
    {"Name": "s3_key", "Type": "string"},
    {"Name": "region", "Type": "string"},
    {"Name": "billable_seconds", "Type": "double"},
    {"Name": "estimated_cost_usd", "Type": "double"},
    {"Name": "actual_cost_usd", "Type": "double"},
    {"Name": "notes", "Type": "string"}
  ],
  "partition_keys": [
    {"Name": "prompt_id", "Type": "string"},
    {"Name": "device", "Type": "string"},
    {"Name": "subject", "Type": "string"}
  ],
  "partition_projection": {
    "prompt_id": {
      "type": "enum",
      "values": ["AWS-003", "IBM-HERON"]
    },
    "device": {
      "type": "enum",
      "values": ["SV1", "default_simulator", "ibm_torino", "Aria-1", "Forte-1", "Garnet"]
    },
    "subject": {
      "type": "enum",
      "values": ["chb01", "chb03", "chb05", "chb07", "chb11", "chb14", "chb21"]
    }
  }
}
